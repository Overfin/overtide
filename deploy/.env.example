# Copy to .env, next to compose.yaml.

# Where your films, series and downloads are, on this machine, and the path
# Radarr, Sonarr and your torrent client see them at, inside their own
# containers: Overtide must use the same.
MEDIA_DIR=/srv/media
MEDIA_PATH=/data

# The user and group that own those files.
PUID=1000
PGID=1000

# Optional: the port Overtide answers on (8088 by default), its config
# folder, and your time zone (for its daily logs).
OVERTIDE_PORT=8088
CONFIG_DIR=./config
TZ=UTC
